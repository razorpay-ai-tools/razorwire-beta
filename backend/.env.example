DATABASE_URL=sqlite:///./razorwire.db
WEB_ORIGIN=http://localhost:3000

# Local-only auth bypass. Do not set this in shared deployments.
DEV_AUTH_EMAIL=you@razorpay.com

GOOGLE_CLIENT_ID=
ALLOWED_HD=razorpay.com

# The script stage runs through Razorpay's LiteLLM gateway, which speaks Anthropic's
# /v1/messages shape for whatever model it routes. This key is the only paid dependency
# in the pipeline; everything else is our box or an internal service.
LITELLM_API_KEY=
LLM_BASE_URL=https://llm-gateway.razorpay.com
LLM_MODEL=glm-5p2

# Only if you hold a direct Anthropic key instead of a gateway one. Used when
# LITELLM_API_KEY is empty; clear LLM_BASE_URL as well so it talks to Anthropic.
ANTHROPIC_API_KEY=

# Local upload fallback. Use S3/Supabase Storage for shared deployments.
MEDIA_DIR=./.storage

# Scratch space for one generation run: storyboard.json, scene wavs, scene pngs.
# Deliberately NOT served at any URL, unlike MEDIA_DIR.
WORK_DIR=./.work

# Slack ingestion. Bot token (xoxb-...) with scopes channels:history,
# groups:history, channels:read, users:read. The bot must also be INVITED to each
# channel it reads, or Slack answers `not_in_channel`.
SLACK_BOT_TOKEN=

# Comma-separated channel ids or names we may ingest from. Empty means none:
# ingesting a channel is opt-in, because a thread's participants did not write it
# for the feed. e.g. C0192KLMN,#payments-platform
SLACK_ALLOWED_CHANNELS=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=razorwire-videos
SUPABASE_STORAGE_PUBLIC=true
MAX_UPLOAD_BYTES=52428800

# --- aidocs ingestion --------------------------------------------------------
AIDOCS_SERVER=https://aidocs.razorpay.com

# Service-account key: `aidocs sa create razorwire-ingest` then
# `aidocs sa key create <sa_id>`. REQUIRED anywhere that is not a developer laptop —
# unset, the code falls back to the aidocs CLI's own Google session, which does not
# exist in a container. A personal token works and is the wrong choice: it reads with
# that person's permissions and dies when they leave.
AIDOCS_TOKEN=
