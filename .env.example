# Razorwire backend configuration.
#
#   cd backend && cp ../.env.example .env
#
# Every key here is read by backend/app/config.py. Values shown are the defaults —
# only ANTHROPIC_API_KEY and DEV_AUTH_EMAIL are needed to run locally.
#
# NEVER commit a filled-in .env. The repo is public and .env is gitignored.

# --- pipeline ----------------------------------------------------------------
# The one paid, off-perimeter call in the whole flow. Required to generate.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- auth --------------------------------------------------------------------
# Local escape hatch: when set, requests with no bearer token are treated as this
# user. Leave EMPTY in anything shared — it is a complete auth bypass.
DEV_AUTH_EMAIL=

# Real auth. Google ID tokens, restricted to the hosted domain.
GOOGLE_CLIENT_ID=
ALLOWED_HD=razorpay.com

# --- slack ingestion ---------------------------------------------------------
# Bot token (xoxb-...). Scopes: channels:history, groups:history, channels:read,
# users:read. The bot must also be INVITED to each channel it reads, or Slack
# answers `not_in_channel`.
SLACK_BOT_TOKEN=

# Comma-separated channel ids or names we may ingest from. Empty means none:
# ingesting a channel is opt-in, because a thread's participants did not write it
# for the feed. e.g. C0192KLMN,#payments-platform
SLACK_ALLOWED_CHANNELS=

# --- storage -----------------------------------------------------------------
DATABASE_URL=sqlite:///./razorwire.db

# Uploads and finished MP4s. PUBLICLY SERVED at /media — finished artefacts only.
MEDIA_DIR=./.storage

# Scratch space for one generation run: storyboard.json, scene wavs, scene pngs.
# Deliberately NOT served at any URL; it holds intermediate work derived from
# internal documents.
WORK_DIR=./.work

# --- web ---------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000
