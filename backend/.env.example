DATABASE_URL=sqlite:///./razorwire.db
WEB_ORIGIN=http://localhost:3000

# Local-only auth bypass. Do not set this in shared deployments.
DEV_AUTH_EMAIL=you@razorpay.com

GOOGLE_CLIENT_ID=
ALLOWED_HD=razorpay.com

# The script stage runs through Razorpay's LiteLLM gateway, which speaks Anthropic's
# /v1/messages shape for whatever model it routes. This key is the only paid dependency
# in the pipeline; everything else is our box or an internal service.
LITELLM_API_KEY=
LLM_BASE_URL=https://llm-gateway.razorpay.com
LLM_MODEL=glm-5p2

# Only if you hold a direct Anthropic key instead of a gateway one. Used when
# LITELLM_API_KEY is empty; clear LLM_BASE_URL as well so it talks to Anthropic.
ANTHROPIC_API_KEY=

# Local upload fallback. Use S3/Supabase Storage for shared deployments.
MEDIA_DIR=./.storage

# Scratch space for one generation run: storyboard.json, scene wavs, scene pngs.
# Deliberately NOT served at any URL, unlike MEDIA_DIR.
WORK_DIR=./.work

# Slack ingestion. Bot token (xoxb-...), READ-ONLY: the integration only ever GETs
# conversations.replies, conversations.info and users.info, so it needs exactly
# channels:history, groups:history, channels:read, users:read and no write scope.
# The bot must also be INVITED to each channel it reads, or Slack answers
# `not_in_channel`.
#
# No channel allow-list: any thread you can link can be ingested. The restriction is
# on our side instead — a Slack-sourced post is pinned to the Announcements channel.
SLACK_BOT_TOKEN=

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=razorwire-videos
SUPABASE_STORAGE_PUBLIC=true
MAX_UPLOAD_BYTES=52428800

# MP4 render path. Defaults are fine; the machine also needs ffmpeg on PATH,
# `playwright install chromium`, and espeak-ng (brew install espeak-ng) for the
# Kokoro voice. Background footage comes from BROLL_DIR/<mood>.mp4 (dataflow,
# servers, team, money, abstract, city); a mood with no clip falls back to a
# gradient, so clips are optional per mood.
# Voice is <lang><gender>_<name>; the first letter also picks the phonemiser.
# af_heart is the only A-graded voice; af_bella (A-) is warmer, bf_emma is British.
# The Hindi packs (hf_alpha/hf_beta) are the nearest to Indian English but grade C.
KOKORO_VOICE=af_heart
KOKORO_SPEED=0.95
BROLL_DIR=../public/broll
RENDER_TTS=auto
