            "$ref": "#/$defs/CompareScene"
          },
          {
            "$ref": "#/$defs/CodeScene"
          },
          {
            "$ref": "#/$defs/OutroScene"
          }
        ]
      },
      "maxItems": 8,
      "minItems": 3,
      "title": "Scenes",
      "type": "array"
    }
