    "source": {
      "$ref": "#/$defs/StoryboardSource"
    },
    "scenes": {
      "description": "3-8 scenes, under 60 seconds spoken in total.",
      "items": {
        "discriminator": {
          "mapping": {
            "bullets": "#/$defs/BulletsScene",
            "code": "#/$defs/CodeScene",
            "compare": "#/$defs/CompareScene",
            "diagram": "#/$defs/DiagramScene",
            "outro": "#/$defs/OutroScene",
            "title": "#/$defs/TitleScene"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/TitleScene"
          },
          {
            "$ref": "#/$defs/BulletsScene"
          },
          {
            "$ref": "#/$defs/DiagramScene"
          },
