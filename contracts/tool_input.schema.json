{
  "$defs": {
    "Broll": {
      "additionalProperties": false,
      "properties": {
        "mood": {
          "$ref": "#/$defs/BrollMood",
          "description": "Background footage mood. Chosen from the fixed set only."
        }
      },
      "required": [
        "mood"
      ],
      "title": "Broll",
      "type": "object"
    },
    "BrollMood": {
      "description": "The ONLY vocabulary Claude has for choosing footage.\n\nGenerative video cannot render legible text or an accurate diagram, so Veo is\nused strictly as a background plate and never as the carrier of information.\nClaude picks a mood from this closed set; a resolver maps the mood to a\npre-generated, human-prompted Veo clip. Consequences of doing it this way: no\nspec content ever reaches a video prompt, no per-request generation cost, and\nno generation latency on the request path.",
      "enum": [
        "dataflow",
        "servers",
        "team",
        "money",
        "abstract",
        "city"
      ],
      "title": "BrollMood",
      "type": "string"
    },
    "BulletsScene": {
      "additionalProperties": false,
      "properties": {
        "narration": {
          "description": "What the voice says over this scene. Plain spoken prose. No markdown, no stage directions. Expand abbreviations a voice would stumble on.",
          "maxLength": 420,
          "minLength": 10,
          "title": "Narration",
          "type": "string"
        },
        "cite": {
          "anyOf": [
            {
              "maxLength": 80,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "The source section this scene came from, e.g. \"Section 4 - Proposed Architecture\". Rendered on screen as a chip. Required for factual scenes when the source is an AIDoc.",
          "title": "Cite"
        },
        "broll": {
          "anyOf": [
            {
              "$ref": "#/$defs/Broll"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "type": {
          "const": "bullets",
          "title": "Type",
          "type": "string"
        },
        "heading": {
          "maxLength": 60,
          "minLength": 3,
          "title": "Heading",
          "type": "string"
        },
        "bullets": {
          "description": "Short phrases, not sentences. These are read on screen, not aloud.",
          "items": {
            "maxLength": 80,
            "minLength": 3,
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Bullets",
          "type": "array"
        }
      },
      "required": [
        "narration",
        "type",
        "heading",
        "bullets"
      ],
      "title": "BulletsScene",
      "type": "object"
    },
