    "StoryboardMeta": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "description": "Feed title. Punchy, not the document title verbatim.",
          "maxLength": 70,
          "minLength": 4,
          "title": "Title",
          "type": "string"
        },
        "tags": {
          "items": {
            "pattern": "^[a-z0-9-]+$",
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Tags",
          "type": "array"
        }
      },
      "required": [
        "title",
        "tags"
      ],
      "title": "StoryboardMeta",
      "type": "object"
    },
