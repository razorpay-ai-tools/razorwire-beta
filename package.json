{
  "name": "razorwire",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:all": "bash scripts/dev.sh",
    "dev": "next dev",
    "build": "next build",
    "build:aisites": "NEXT_PUBLIC_BACKEND_MODE=api NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL:-https://razorwire-api-production.up.railway.app} AISITES_EXPORT=1 next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "check:aisites": "node --no-warnings src/lib/__check-aisites-api.mts",
    "gen:types": "cd backend && uv run python scripts/emit_contract.py"
  },
  "dependencies": {
    "mermaid": "^11.16.1",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
