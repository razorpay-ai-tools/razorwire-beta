DATABASE_URL=sqlite:///./razorwire.db
WEB_ORIGIN=http://localhost:3000

# Local-only auth bypass. Do not set this in shared deployments.
DEV_AUTH_EMAIL=you@razorpay.com

GOOGLE_CLIENT_ID=
ALLOWED_HD=razorpay.com

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Slack ingestion. The allow-list is opt-in: empty means no channel can be read.
SLACK_BOT_TOKEN=
SLACK_ALLOWED_CHANNELS=

# Local upload fallback. Use S3/Supabase Storage for shared deployments.
MEDIA_DIR=./.storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=razorwire-videos
SUPABASE_STORAGE_PUBLIC=true
MAX_UPLOAD_BYTES=52428800

# Scratch space for a generation run. Never served at a URL.
WORK_DIR=./.work
